APP_NAME="E-Surat BPRS Sragen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://esurat.bprs-sragen.local
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=esurat
DB_USERNAME=esurat_app
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Isi lewat pengelola rahasia server, jangan commit nilai aslinya.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME="Admin E-Surat"
INITIAL_ADMIN_PASSWORD=
